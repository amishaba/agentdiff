# AgentDiff uses a Gemini key to power AI grading, the "Likely cause" explanation,
# and `agentdiff generate-tests`.
# Copy this file to `.env` in the folder you run `agentdiff` from, then paste your key.
# (agentdiff loads a .env from your current directory automatically.)

# Gemini (Google AI Studio):
GEMINI_API_KEY=

# Optional: override the model used for grading + explanation
# AGENTDIFF_MODEL=gemini-2.5-flash
