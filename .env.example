# A comparison runs every stage, so it needs both keys.
# Copy this file to `.env` in the folder you run `agentdiff` from, then paste them.
# (agentdiff loads a .env from your current directory automatically.)

# Jev (TypeSafe) through Vercel AI Gateway: grades every run and answers the checks.
AI_GATEWAY_API_KEY=

# OpenAI: discovery planning, the "Likely cause" explanation, and `agentdiff generate-tests`.
OPENAI_API_KEY=

# Optional: have OpenAI grade and answer the checks instead of Jev (or set grader: "openai" in the config).
# AGENTDIFF_GRADER=openai

# Optional: override the OpenAI model
# AGENTDIFF_MODEL=gpt-5.4

# Optional: run only the agents and the exact comparison, with no model calls from agentdiff.
# AGENTDIFF_OFFLINE=1

# Optional: connect Braintrust without entering a key in the local dashboard.
# BRAINTRUST_API_KEY=
