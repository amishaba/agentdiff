{
  "name": "agentdiff",
  "version": "0.1.0",
  "description": "Compare two versions of an AI agent (Mastra, OpenAI Agents SDK, or any function) and report how its behaviour changed.",
  "license": "MIT",
  "author": "Amisha Bansal (https://github.com/amishaba)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amishaba/agentdiff.git"
  },
  "homepage": "https://agent-diff.vercel.app",
  "bugs": {
    "url": "https://github.com/amishaba/agentdiff/issues"
  },
  "keywords": [
    "mastra",
    "ai-agent",
    "agent-testing",
    "llm",
    "regression",
    "evaluation",
    "cli",
    "diff",
    "openai-agents"
  ],
  "type": "module",
  "bin": {
    "agentdiff": "bin/agentdiff.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist/web",
    "example/agents",
    "example/tests",
    "example/agentdiff.config.ts",
    "example/discovery-fixtures.ts",
    "example/package.json",
    "example-openai/agents",
    "example-openai/agentdiff.config.ts",
    "example-openai/package.json",
    "example-booking/agents",
    "example-booking/tests",
    "example-booking/world.ts",
    "example-booking/agentdiff.config.ts",
    "example-booking/package.json",
    "example-sms/agents",
    "example-sms/tests",
    "example-sms/world.ts",
    "example-sms/agentdiff.config.ts",
    "example-sms/package.json",
    "example-clinic/agents",
    "example-clinic/tests",
    "example-clinic/agent.ts",
    "example-clinic/prompt.ts",
    "example-clinic/tools.ts",
    "example-clinic/world.ts",
    "example-clinic/agentdiff.config.ts",
    "example-clinic/package.json",
    "tsconfig.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node bin/agentdiff.mjs",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "demo:standalone": "node scripts/build-standalone-demo.mjs",
    "bake-example": "node --import tsx scripts/bake-example.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build:web",
    "bake-dashboard-demo": "node --import tsx scripts/bake-dashboard-demo.ts",
    "bake-scenarios-demo": "node --import tsx scripts/bake-scenarios-demo.ts",
    "bake-check-demo": "node --import tsx scripts/bake-check-demo.ts",
    "bake-workspace-demo": "node --import tsx scripts/bake-demo-from-workspace.ts",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,web/src}/**/*.{ts,tsx,mjs,js}\" \"*.{js,ts}\" web/vite.config.ts bin/*.mjs",
    "format:check": "prettier --check \"{src,test,scripts,web/src}/**/*.{ts,tsx,mjs,js}\" \"*.{js,ts}\" web/vite.config.ts bin/*.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.81",
    "ai": "^7.0.122",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mastra/core": ">=0.10.0",
    "@openai/agents": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mastra/core": "1.63.2",
    "@openai/agents": "^0.18.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
