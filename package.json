{
  "name": "agentdiff",
  "version": "0.1.0",
  "description": "Compare two versions of a Mastra agent and report how its behaviour changed.",
  "license": "MIT",
  "author": "amisha@getomni.ai",
  "keywords": [
    "mastra",
